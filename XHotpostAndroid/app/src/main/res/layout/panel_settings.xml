<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. X 账号登录（无 API）"
            android:textColor="#D6FF4B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtXStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="未登录"
            android:textColor="#9BB3AA"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editXUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="你的 X 用户名（可选，如 @name）"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <Button
            android:id="@+id/btnLoginX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="去登录 X（浏览器 / 官方 App）" />

        <Button
            android:id="@+id/btnOpenXApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="仅打开 X App" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已登录 X（登录成功后会自动勾选）"
                android:textColor="#F3F7F2" />

            <Switch
                android:id="@+id/switchXLoggedIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="2. 跟踪 X 热搜"
            android:textColor="#D6FF4B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="只拉 X 平台热搜（公开趋势镜像，不用官方 API）。赛道用于优先排序匹配话题。"
            android:textColor="#9BB3AA"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="热搜地区"
            android:textColor="#F3F7F2"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/groupXRegion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/regionAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自动（跟内容语言）"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/regionUs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="美国"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/regionUk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="英国"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/regionJp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="日本"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/regionSg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="新加坡"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/regionIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="印度"
                android:textColor="#F3F7F2" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="赛道（优先匹配）"
            android:textColor="#F3F7F2"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/groupNiche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/nicheTech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="科技 / AI"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/nicheFinance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="财经投资"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/nicheLifestyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="生活方式"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/nicheCreator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自媒体变现"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/nicheLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="综合 X 热搜（不过滤）"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/nicheCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自定义关键词"
                android:textColor="#F3F7F2" />
        </RadioGroup>

        <EditText
            android:id="@+id/editCustomNiche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="自定义话题关键词，例如：温哥华房价"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="内容语言"
            android:textColor="#F3F7F2"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/groupLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/langZh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中文"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/langEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="英文"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/langMixed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="混合"
                android:textColor="#F3F7F2" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="3. 内容风格（提升文案质量）"
            android:textColor="#D6FF4B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="本地模板已改成更像真人短帖。想要明显更好：打开 AI 写稿并填 Key（DeepSeek/OpenAI 等），写完可在审核台点「换一版」。"
            android:textColor="#9BB3AA"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/groupStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/styleOpinion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="观点鲜明"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/styleHowto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="干货拆解"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/styleStory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="故事场景"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/styleCasual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="口语随性"
                android:textColor="#F3F7F2" />

            <RadioButton
                android:id="@+id/stylePro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="专业克制"
                android:textColor="#F3F7F2" />
        </RadioGroup>

        <EditText
            android:id="@+id/editPersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="人设 / 语气（例如：犀利但不人身攻击，爱用短句）"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启用 AI 写稿（OpenAI 兼容）"
                android:textColor="#F3F7F2" />

            <Switch
                android:id="@+id/switchAi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <EditText
            android:id="@+id/editAiBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="API Base URL（如 https://api.openai.com/v1）"
            android:inputType="textUri"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <EditText
            android:id="@+id/editAiModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="模型名（如 gpt-4o-mini / deepseek-chat）"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <EditText
            android:id="@+id/editAiApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="API Key（仅存本机）"
            android:inputType="textPassword"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="4. 变现与发布"
            android:textColor="#D6FF4B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDisplayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="显示名"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <EditText
            android:id="@+id/editAffiliate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="变现链接"
            android:inputType="textUri"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <EditText
            android:id="@+id/editCta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="CTA 模板（可用 {link}）"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="演示模式（不真发帖）"
                android:textColor="#F3F7F2" />

            <Switch
                android:id="@+id/switchDemo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="自动写草稿"
                android:textColor="#F3F7F2" />

            <Switch
                android:id="@+id/switchAutoDraft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="通过后打开 X 发帖"
                android:textColor="#F3F7F2" />

            <Switch
                android:id="@+id/switchAutoPublish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="保存设置" />

        <Button
            android:id="@+id/btnRegenDrafts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="按当前风格重写待审草稿" />
    </LinearLayout>
</ScrollView>
