<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071411"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="登录 X 账号"
            android:textColor="#D6FF4B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="不要用 i/flow/login（容易失败）。请用下面稳定登录页，或直接打开官方 App。登录后回到本页点「我已登录成功」。"
            android:textColor="#9BB3AA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtAppStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFC857"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnBrowserLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="① 打开稳定登录页（mobile.twitter.com）" />

        <Button
            android:id="@+id/btnAltLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="①b 备用登录页（twitter.com/login）" />

        <Button
            android:id="@+id/btnOpenXApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="② 打开 X / Twitter 官方 App" />

        <Button
            android:id="@+id/btnInstallX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="②b 去应用商店安装 X" />

        <EditText
            android:id="@+id/editUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="你的用户名（可选，如 @name）"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <Button
            android:id="@+id/btnConfirmLoggedIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="③ 我已登录成功" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="如果网页打不开：可能是网络访问 X 受限。可先安装官方 X App 登录；或仅勾选「我已登录成功」（你平时能打开 X 即可发帖）。"
            android:textColor="#9BB3AA"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
