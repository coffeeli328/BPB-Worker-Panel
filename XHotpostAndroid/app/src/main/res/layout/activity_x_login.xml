<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071411"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="登录 X 账号"
            android:textColor="#D6FF4B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="X 会拦截 App 内置网页，所以请用系统浏览器或官方 App 登录。登录完成后回到这里点「我已登录成功」。"
            android:textColor="#9BB3AA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtAppStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFC857"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnBrowserLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="① 用浏览器打开 X 登录页" />

        <Button
            android:id="@+id/btnOpenXApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="② 打开 X / Twitter 官方 App" />

        <EditText
            android:id="@+id/editUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="你的用户名（可选，如 @name）"
            android:textColor="#F3F7F2"
            android:textColorHint="#9BB3AA" />

        <Button
            android:id="@+id/btnConfirmLoggedIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="③ 我已登录成功" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="说明：不使用 X API。真发帖时会跳到 X App / 浏览器，用你已登录的账号发送。"
            android:textColor="#9BB3AA"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
